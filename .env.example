NODE_ENV=development
PORT=3000
JWT_SECRET=super_secret_jwt_key_example

# Storage Mode (in-memory | sql)
STORAGE_MODE=sql

# Database Dialect (postgres | mysql)
DATABASE_DIALECT=postgres

# PostgreSQL Connection URL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/day_status_db

# MySQL Connection URL (uncomment if using MySQL)
# DATABASE_URL=mysql://root:root@localhost:3306/day_status_db

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173
